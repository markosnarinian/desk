---
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
import WorkspaceExample from './WorkspaceExample.astro';

const { id } = Astro.locals.starlightRoute;
const isHome = id === '';
---

{isHome ? (
  <section class="desk-hero" aria-labelledby="_top">
    <div class="hero-copy">
      <h1 id="_top" data-page-title>Local work.<br />Without the sprawl.</h1>
      <p class="hero-description">Scratch experiments. A quick fix in a repo. Local work, without another directory to look after.</p>
      <div class="hero-actions">
        <a class="desk-button primary" href="/quickstart/">Get started <svg aria-hidden="true" width="16" height="16" viewBox="0 0 20 20" fill="none"><path d="M3 10h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5"/></svg></a>
        <a class="desk-button secondary" href="/safety/">Cleanup guarantees</a>
      </div>
      <ul class="platforms" role="list"><li>macOS + Linux</li><li>One Go binary</li><li>Your Git &amp; shell</li></ul>
    </div>
    <WorkspaceExample />
  </section>
) : <DefaultHero><slot /></DefaultHero>}
