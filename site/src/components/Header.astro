---
import DefaultHeader from '@astrojs/starlight/components/Header.astro';
const isHome = Astro.locals.starlightRoute.id === '';
---

{isHome ? (
  <div class="home-header">
    <a class="home-brand" href="/" aria-label="desk home">desk<span aria-hidden="true">_</span></a>
    <nav aria-label="Main navigation">
      <a href="/quickstart/">Docs</a>
      <a class="commands-link" href="/commands/">Commands</a>
      <a href="/safety/">Safety</a>
    </nav>
    <a class="desk-button primary header-cta" href="/installation/">Install desk</a>
  </div>
) : <DefaultHeader><slot /></DefaultHeader>}
